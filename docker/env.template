# Non-secret settings template for the vl-itree InvenTree stack.
#
# run-itree.sh builds the runtime .env (repository root, mode 0600) from:
#   1. this file                       (defaults, tracked in git)
#   2. .env.local                      (owner overrides and secrets, untracked)
#   3. the process environment         (credential keys only)
#   4. docker/versions.env             (pinned images, always wins)
#   5. values computed by the launcher (paths, TLS mode, host lists)
# Do not edit the runtime .env; it is regenerated on every start.
# Do not put real secrets in this file. Values below marked __CHANGE_ME__
# are placeholders; the launcher refuses to start a working instance with them.
#
# Format: KEY=VALUE, one per line, no inline comments, no shell expansion.
# Details: docs/configuration.md. Script constants (paths, container names):
# lib/itree-config.sh.

# Compose project name. "docker" is the name earlier versions of this repo
# used implicitly (the directory holding docker-compose.yml). Changing it
# would orphan the existing containers and network.
COMPOSE_PROJECT_NAME=docker

# ---------------------------------------------------------------------------
# Network exposure
# ---------------------------------------------------------------------------
# Address the HTTPS port is published on. 127.0.0.1 keeps the instance local.
# To serve other machines set a LAN address (or 0.0.0.0) AND an https://
# INVENTREE_SITE_URL; the launcher refuses a non-loopback bind with http://.
# Plain HTTP is always published on 127.0.0.1 only.
INVENTREE_BIND_ADDR=127.0.0.1

# Host ports. Caddy listens on the same port numbers inside its container.
INVENTREE_HTTP_PORT=8080
INVENTREE_HTTPS_PORT=8443

# The URL clients use. Scheme, host and port must match how clients connect;
# the port must equal INVENTREE_HTTPS_PORT (https) or INVENTREE_HTTP_PORT
# (http). It drives Caddy's site address, Django ALLOWED_HOSTS,
# CSRF_TRUSTED_ORIGINS and CORS origins.
INVENTREE_SITE_URL=https://localhost:8443

# Certificate mode for https:// site URLs:
#   internal - Caddy's internal CA issues the certificate. Export the root
#              with "run-itree.sh export-ca" and install it on clients.
#   owner    - owner-supplied certificate chain and key (PEM), mounted
#              read-only. Set INVENTREE_TLS_CERT_FILE and INVENTREE_TLS_KEY_FILE
#              to absolute paths outside this repository.
INVENTREE_TLS_MODE=internal
INVENTREE_TLS_CERT_FILE=
INVENTREE_TLS_KEY_FILE=

# ---------------------------------------------------------------------------
# InvenTree application settings
# ---------------------------------------------------------------------------
INVENTREE_WEB_PORT=8000
INVENTREE_DEBUG=False
INVENTREE_LOG_LEVEL=INFO
INVENTREE_DB_LOGGING=False
INVENTREE_PLUGINS_ENABLED=True
INVENTREE_GUNICORN_TIMEOUT=90

# Run database migrations automatically when the pinned image changes.
# Change the pinned tag only after a fresh offline backup (docs/upgrade.md).
INVENTREE_AUTO_UPDATE=True

# Caddy terminates TLS and forwards scheme, host and port.
INVENTREE_USE_X_FORWARDED_HOST=True
INVENTREE_USE_X_FORWARDED_PORT=True
INVENTREE_USE_X_FORWARDED_PROTO=True

# The config.yaml generated on first start allows all CORS origins.
# Override it: only INVENTREE_SITE_URL is an allowed origin.
INVENTREE_CORS_ORIGIN_ALLOW_ALL=False

# ---------------------------------------------------------------------------
# Database (must match the existing data directory; do not change)
# ---------------------------------------------------------------------------
INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_NAME=inventree
INVENTREE_DB_HOST=inventree-db
INVENTREE_DB_PORT=5432
INVENTREE_DB_USER=inventree
# Secret: set in .env.local (or the environment), never here.
INVENTREE_DB_PASSWORD=__CHANGE_ME__

# ---------------------------------------------------------------------------
# Redis cache
# ---------------------------------------------------------------------------
INVENTREE_CACHE_ENABLED=True
INVENTREE_CACHE_HOST=inventree-cache
INVENTREE_CACHE_PORT=6379
