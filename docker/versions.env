# Pinned container images for the vl-itree InvenTree stack.
#
# This file is the single source of truth for image versions. run-itree.sh
# copies these values into the runtime .env (they cannot be overridden from
# .env.local), and docker/docker-compose.yml references each image as
# <name>:<TAG>@<DIGEST>. Keep the README "Pinned images" table in sync.
# Repository names per prefix: ITREE_IMAGE_TABLE in lib/itree-config.sh.
#
# Digests are the multi-arch index digests from Docker Hub, verified on
# 2026-11-21 against registry-1.docker.io (Docker-Content-Digest header).
#
# Change INVENTREE_TAG / INVENTREE_DIGEST only after a fresh offline backup
# (bash run-itree-dump.sh --offline --no-restart). See docs/upgrade.md.

# InvenTree 1.7.3 (GitHub release 2026-11-17; same digest as the floating
# "stable" tag at the time of pinning)
INVENTREE_TAG=1.7.3
INVENTREE_DIGEST=sha256:bd58a1d1891dac39a19b5c40a7fa6bd9fc4d6752ae0bd69da4582a4afce5dfb7

# PostgreSQL 17.12 (same digest as postgres:17). Major version 17 matches the
# existing data directory and the official 1.7.3 compose recipe.
# A major-version change requires dump and restore; never change "17" here
# without following docs/upgrade.md, "PostgreSQL major upgrade".
POSTGRES_TAG=17.12
POSTGRES_DIGEST=sha256:b60e90042aa6b8dbecd58e224b3e36114dbf8ad754465264c2476ad58a86e45c

# Redis 7.4.12 (same digest as redis:7-alpine, used by the official recipe)
REDIS_TAG=7.4.12-alpine
REDIS_DIGEST=sha256:7f7d30b7fdd09467bac58198a1f166dd69789d348d4fe859cccb20e0cf287fbe

# Caddy 2.11.9 (same digest as caddy:alpine, used by the official recipe)
CADDY_TAG=2.11.9-alpine
CADDY_DIGEST=sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
