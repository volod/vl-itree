# Example local secrets and overrides for the vl-itree InvenTree stack.
#
#   cp .env.local.example .env.local && chmod 600 .env.local
#
# .env.local is untracked (.gitignore) and is never overwritten or deleted by
# the scripts, except that "run-itree.sh rotate-db-password" replaces the
# INVENTREE_DB_PASSWORD line in place.
#
# Format: KEY=VALUE, one per line, no inline comments, no shell expansion.
# Secret values must be at least 16 characters, must not be a placeholder or
# a well-known default (such as "inventree"), and must not contain
# whitespace, quotes, backslash, backtick, '$' or '#'. See docs/secrets.md.

# Database password. For a NEW data directory, PostgreSQL adopts this value
# on first start. For an EXISTING data directory, PostgreSQL keeps its old
# password: run "bash run-itree.sh rotate-db-password" instead of editing
# this line by hand.
INVENTREE_DB_PASSWORD=__CHANGE_ME__

# Optional: create a superuser on first start (only if it does not exist).
# Remove these lines after the account exists.
#INVENTREE_ADMIN_USER=admin
#INVENTREE_ADMIN_EMAIL=admin@example.invalid
#INVENTREE_ADMIN_PASSWORD=__CHANGE_ME__

# Optional overrides of docker/env.template, for example remote access
# (docs/network-tls.md):
#INVENTREE_BIND_ADDR=192.168.1.20
#INVENTREE_SITE_URL=https://inventree.lan:8443
#INVENTREE_TLS_MODE=internal
#INVENTREE_TLS_MODE=owner
#INVENTREE_TLS_CERT_FILE=/etc/vl-itree/tls/fullchain.pem
#INVENTREE_TLS_KEY_FILE=/etc/vl-itree/tls/privkey.pem
