# project code
InvenTree/

# Environment files
# .env is generated by run-itree.sh; .env.local holds the owner's secrets.
.env
.env.tmp.*
.env.bak
.env.template
.env.local
.env.local.*
!.env.local.example

# TLS material and exported CA certificates never live in the repository
*.pem
*.key
*.crt

# Local data volumes and backups
inventree-volume/
inventree-dump/

# Docker image cache
docker-images/

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/


